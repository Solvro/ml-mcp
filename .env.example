########################################
# LLM / AI Provider Keys
########################################

# OpenAI API key (optional)
OPENAI_API_KEY=

# DeepSeek API key (optional)
DEEPSEEK_API_KEY=

# Google Generative AI / PaLM API key (optional)
GOOGLE_API_KEY=

# CLARIN LLM API key (optional, used by API & client)
CLARIN_API_KEY=


########################################
# Logging
########################################

# Root log level for every entry point: DEBUG, INFO, WARNING, ERROR or CRITICAL
# (unset or unrecognised falls back to INFO). DEBUG is the whole root logger, so it also
# turns on mcp/httpx/neo4j/asyncio debug output, not just ours.
# Prefect flow logs are separate and follow PREFECT_LOGGING_LEVEL.
LOG_LEVEL=INFO

# Optional logging.Formatter string; leave empty for the default
# LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s


########################################
# Langfuse Observability
########################################

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com


########################################
# Neo4j Database
########################################

# URI used by data pipeline, MCP server and graph config
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Optional overrides (defaults live in graph_config.yaml → rag.*)
# LLM_TIMEOUT_SECONDS=30
# GRAPH_TIMEOUT_SECONDS=90

########################################
# Data Pipeline Runtime Controls
########################################

# Staging directory with documents produced by source scraper job
DATA_PIPELINE_STAGING_DIR=data/staging

# --- Source acquisition / refresh (src/data_pipeline/flows/source_refresh.py) ---

# Comma-separated seed URLs to crawl (required for the refresh flow)
DATA_PIPELINE_SOURCE_URLS=

# How many link hops from each seed to follow (0 = seeds only)
DATA_PIPELINE_CRAWL_DEPTH=1

# Seconds to wait between requests; too fast trips bot protection
DATA_PIPELINE_REQUEST_DELAY=1.0

# Comma-separated URL substrings to skip (tracking redirects, calendars, ...)
DATA_PIPELINE_EXCLUDE_PATTERNS=/addtrack/

# Cap documents per run (0 = no limit); sitemaps can list thousands of pages
DATA_PIPELINE_MAX_DOCUMENTS=0

# Cron schedule for the source refresh deployment (default: daily 03:00)
DATA_PIPELINE_REFRESH_CRON=0 3 * * *

OCR_MIN_TEXT_CHARS=50
OCR_PDF_RENDER_SCALE=2.0
OCR_LANG=pol+eng
TESSERACT_CMD=

# Max parallel pages processed per batch in src/data_pipeline/pipeline.py
DATA_PIPELINE_MAX_CONCURRENCY=4

# Minutes after which an in-progress document claim can be reclaimed
DATA_PIPELINE_CLAIM_STALE_MINUTES=30


########################################
# Neo4j dump path and optional Drive copy dir
########################################

PIPELINE_HOST_DUMP_DIR=dumps
PIPELINE_DRIVE_OUT=


########################################
# MCP Server Networking
########################################

# Bind host for the MCP server process
MCP_BIND_HOST=0.0.0.0

# Host/port used by API and MCP client to reach the MCP server
MCP_HOST=127.0.0.1
MCP_PORT=8005